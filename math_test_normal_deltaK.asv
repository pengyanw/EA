Nu = 10; Nx = 18; sigma = 0.1;
Knorm = 5.0; r = 0.1;            % 相对阈值: ||ΔK|| > r ||K||
tau = r * Knorm;
[pF, p2] = prob_norm_exceed(Nu, Nx, sigma, tau);

% 若有稳定性余量 Γ 且已知 ||B||_2:
Gamma = 0.05; Bnorm = 12.3;
[~, pUnstableUB] = prob_norm_exceed(Nu, Nx, sigma, Gamma, Bnorm);

function [pF, pSpecUB] = prob_norm_exceed(Nu, Nx, sigma, tau, Bnorm)
% 计算 P(||ΔK||_F > tau) 的精确值 以及 P(||ΔK||_2 > tau) 的上界
% Nu,Nx: 维度; sigma: N(0, sigma^2); tau: 阈值
% Bnorm 可选：若给出，则返回 P(||BΔK||_2 > Γ) 上界，令 tau = Γ/Bnorm

    if nargin < 5, Bnorm = []; end
    m = Nu * Nx;

    % -- Frobenius: exact via chi-square
    x = (tau^2) / (sigma^2);
    pF = 1 - chi2cdf(x, m);

    % -- Spectral: Vershynin tail bound
    mu = sigma * (sqrt(Nu) + sqrt(Nx));
    disp(mu)
    if tau <= mu
        pSpecUB = 1;  % 界仅对 tau >= mu 有意义
    else
        t = tau - mu;
        pSpecUB = exp(-(t^2) / (2*sigma^2))
    end

    % 示例：若要稳定性界 ||BΔK||_2 < Γ 的失稳概率上界
    if ~isempty(Bnorm)
        Gamma = tau;            % 这里把输入 tau 理解为 Γ
        tau2  = Gamma / Bnorm;  % 转成 ||ΔK||_2 的阈值
        mu    = sigma * (sqrt(Nu) + sqrt(Nx));
        if tau2 <= mu
            pSpecUB = 1;
        else
            t = tau2 - mu;
            pSpecUB = exp(-(t^2) / (2*sigma^2));
        end
    end
end
